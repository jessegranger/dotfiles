#!/usr/bin/env bash

if [ ! -f "$PW_FILE" ]; then
	echo Specified input file: \"$PW_FILE\", was not found.
	exit 1
fi

# Pick the platform-appropriate clipboard command.
#   macOS:           pbcopy
#   Linux (Wayland): wl-copy
#   Linux (X11):     xclip or xsel
clip_cmd() {
	if command -v pbcopy >/dev/null 2>&1; then
		echo "pbcopy"
	elif command -v wl-copy >/dev/null 2>&1; then
		echo "wl-copy"
	elif command -v xclip >/dev/null 2>&1; then
		echo "xclip -selection clipboard"
	elif command -v xsel >/dev/null 2>&1; then
		echo "xsel --clipboard --input"
	else
		return 1
	fi
}

# Send the given password to the clipboard via the platform-appropriate tool.
copy_to_clipboard() {
	cmd=$(clip_cmd)
	if [ -n "$cmd" ]; then
		printf '%s' "$1" | $cmd
		echo "(password copied to clipboard)"
	else
		echo "(no clipboard tool found; password not copied)" >&2
	fi
}

matches=$(decrypt "$PW_FILE" | grep $*)

if [ -z "$matches" ]; then
	echo No matches
	exit 0
fi

count=$(echo "$matches" | wc -l | tr -d ' ')

if [ "$count" -eq 1 ]; then
	# Single match: print it with the password (3rd field) masked, then copy.
	echo "$matches" | awk -F, 'BEGIN { OFS = "," } { gsub(/./, "X", $3); print }'
	password=$(echo "$matches" | awk -F, '{ print $3 }')
	copy_to_clipboard "$password"
else
	# Multiple matches: show a numbered list with passwords masked, then ask.
	echo "$matches" | awk -F, 'BEGIN { OFS = "," } { gsub(/./, "X", $3); printf "%d) %s\n", NR, $0 }'
	printf "Select an entry [1-%s]: " "$count"
	read -r choice

	case "$choice" in
		'' | *[!0-9]*)
			echo "Invalid selection." >&2
			exit 1
			;;
	esac

	if [ "$choice" -lt 1 ] || [ "$choice" -gt "$count" ]; then
		echo "Selection out of range." >&2
		exit 1
	fi

	password=$(echo "$matches" | awk -F, -v n="$choice" 'NR == n { print $3 }')
	copy_to_clipboard "$password"
fi
